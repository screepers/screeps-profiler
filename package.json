{
  "name": "screeps-profiler",
  "version": "3.0.0",
  "description": "A profiler designed for use in the game of Screeps.",
  "main": "screeps-profiler.js",
  "types": "screeps-profiler.d.ts",
  "exports": {
    ".": {
      "types": "./screeps-profiler.d.ts",
      "default": "./screeps-profiler.js"
    },
    "./decorator": {
      "types": "./decorator.d.ts",
      "default": "./decorator.js"
    }
  },
  "scripts": {
    "test": "npm run lint && npm run typecheck && jest --coverage",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --project __tests__/tsconfig.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/screepers/screeps-profiler.git"
  },
  "keywords": [
    "screeps",
    "profiler"
  ],
  "author": "Gary Borton <gdborton@gmail.com>",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/screepers/screeps-profiler/issues"
  },
  "homepage": "https://github.com/screepers/screeps-profiler#readme",
  "engines": {
    "node": ">=24"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "screeps-profiler.js",
      "decorator.js"
    ],
    "coverageReporters": [
      "text",
      "text-summary",
      "html",
      "lcovonly"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "jest": "^30.4.2",
    "typescript": "^7.0.2"
  }
}
